{
  "name": "@dimarborda/xlsx-editor",
  "version": "0.3.0",
  "description": "Excel (.xlsx) editor for the browser and engine for Node.js: Rust + WebAssembly that edits workbooks without losing what it does not touch, from a canvas grid or from code. An AI agent can read a table's structure without loading the whole sheet",
  "type": "module",
  "license": "MIT",
  "author": "Dimar Borda",
  "homepage": "https://github.com/dimarborda/rust-web-docx/blob/master/docs/xlsx-editor/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimarborda/rust-web-docx.git",
    "directory": "packages/xlsx-editor"
  },
  "keywords": [
    "ai-agents",
    "xlsx",
    "excel",
    "spreadsheet",
    "editor",
    "viewer",
    "formulas",
    "template",
    "webassembly",
    "wasm",
    "rust",
    "openxml",
    "canvas",
    "web-component"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./engine": {
      "types": "./src/engine.d.ts",
      "default": "./src/engine.js"
    },
    "./fonts": "./src/fonts.js",
    "./style.css": "./src/style.css"
  },
  "types": "./src/index.d.ts",
  "sideEffects": [
    "./src/index.js",
    "./src/fonts.js",
    "*.css"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "node -e \"require('fs').accessSync('wasm/xlsx_engine_bg.wasm')\" || (echo 'Falta el motor WebAssembly: publica con npm run release:xlsx-editor desde la raíz del repositorio' && exit 1)"
  },
  "files": [
    "src",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/tinos": "^5.3.0"
  }
}
