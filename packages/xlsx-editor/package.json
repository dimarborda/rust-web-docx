{
  "name": "@dimarborda/xlsx-editor",
  "version": "0.0.1",
  "description": "Excel (.xlsx) editor for the browser: canvas grid over a Rust + WebAssembly engine, as a framework-agnostic web component",
  "type": "module",
  "license": "MIT",
  "author": "Dimar Borda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimarborda/rust-web-docx.git",
    "directory": "packages/xlsx-editor"
  },
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "viewer",
    "editor",
    "webassembly",
    "wasm",
    "canvas",
    "web-component"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./fonts": "./src/fonts.js",
    "./style.css": "./src/style.css"
  },
  "types": "./src/index.d.ts",
  "sideEffects": [
    "./src/index.js",
    "./src/fonts.js",
    "*.css"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@dimarborda/xlsx": "^0.1.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/tinos": "^5.3.0"
  }
}
